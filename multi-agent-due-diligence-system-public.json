    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "reviewer@example.com",
        "subject": "={{ `Human Review Required \u2014 ${$(\"Prepare Research\").first().json.company_name} \u2014 ${$json.output.overall_risk} Risk` }}",
        "message": "={{ `\nEXECUTIVE ASSESSMENT\n\n${$json.output.final_executive_assessment}\n\nWHY HUMAN REVIEW IS REQUIRED\n\n${$json.output.human_review_reason}\n\nUNRESOLVED FINDINGS\n\n${($json.output.unresolved_findings || []).map((x, i) => `${i + 1}. ${x}`).join('\\n\\n')}\n\nPlease review the assessment and select your decision below.\n` }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve Assessment",
            "disapproveLabel": "Needs further assessment"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        3504,
        0
      ],
      "id": "public-send-a-message",
      "name": "Send a message"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst verificationResults = items.map((item, index) => ({\n  task_id: index + 1,\n  verification_result: item.json.output ?? item.json\n}));\n\nreturn [\n  {\n    json: {\n      verification_count: verificationResults.length,\n      verification_results: verificationResults\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2528,
        16
      ],
      "id": "public-consolidate-verification-results",
      "name": "Consolidate Verification Results"
    },
    {
      "parameters": {
        "jsCode": "const critique = $(\"Due Diligence Critic\").first().json.output;\n\nconst marker = \"VERIFICATION REQUIREMENTS\";\n\nconst section = critique.includes(marker)\n  ? critique.split(marker)[1]\n  : critique;\n\nconst lines = section\n  .split(\"\\n\")\n  .map(line => line.trim())\n  .filter(line => /^\\d+[\\).]/.test(line));\n\nconst topThree = lines.slice(0, 3);\n\nreturn topThree.map((task, index) => ({\n  json: {\n    company_name: $(\"Prepare Research\").first().json.company_name,\n    verification_task_id: index + 1,\n    verification_task: task.replace(/^\\d+[\\).]\\s*/, \"\")\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        16
      ],
      "id": "public-prepare-verification-tasks",
      "name": "Prepare Verification Tasks"
    },
